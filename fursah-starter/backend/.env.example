# Copy to .env and fill in. All settings use the FURSAH_ prefix (see app/infrastructure/config.py).

# Model (OpenRouter) — get a key at https://openrouter.ai/keys
FURSAH_MODEL_PROVIDER=openrouter
FURSAH_MODEL_NAME=openai/gpt-4o-mini
FURSAH_MODEL_API_KEY=
FURSAH_MODEL_BASE_URL=https://openrouter.ai/api/v1

# Blank = real current time. Example fixed time: 2026-10-18T12:00:00+03:00
FURSAH_EVALUATION_TIME=
